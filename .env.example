# Modelo de configuração da API. Copie para `.env` (que o git ignora) e
# preencha. NUNCA versione valores reais. Gere segredos com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# e a chave de oração (32 bytes) com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# desenvolvimento | homologacao | producao
UJ_AMBIENTE=desenvolvimento
PORTA=3333
# Domínio centralizado: trocar de domínio é trocar este valor (ver docs/runbooks/troca-de-dominio.md)
URL_PUBLICA=http://localhost:8081
# Em homologação, informe o domínio de produção: a API recusa subir apontando para ele.
URL_PUBLICA_PRODUCAO=
DATABASE_URL=postgres://uj_api@localhost:5432/unijovem

JWT_SEGREDO=
CONVITE_SEGREDO=
ORACAO_CHAVE=

# desligado | arquivo (só desenvolvimento) | resend
EMAIL_MODO=arquivo
NOTIFICADOR_ARQUIVO=./tmp/notificacoes.txt
EMAIL_REMETENTE=
RESEND_CHAVE=

# Obrigatório em homologação e produção (páginas públicas)
TURNSTILE_SEGREDO=
