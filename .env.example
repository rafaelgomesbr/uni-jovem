# Modelo de configuração da API. Copie para `.env` (que o git ignora) e
# preencha. NUNCA versione valores reais. Gere segredos com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# e a chave de oração (32 bytes) com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# desenvolvimento | homologacao | producao
UJ_AMBIENTE=desenvolvimento
PORTA=3333
# Domínio centralizado: trocar de domínio é trocar este valor (ver docs/runbooks/troca-de-dominio.md)
URL_PUBLICA=http://localhost:8081
# Em homologação, informe o domínio de produção: a API recusa subir apontando para ele.
URL_PUBLICA_PRODUCAO=
# Um usuário por papel do banco (infra/banco/papeis.sql); senhas fora do git.
DATABASE_URL_API=postgres://uj_api:SENHA@localhost:5432/unijovem
DATABASE_URL_AUTH=postgres://uj_auth:SENHA@localhost:5432/unijovem

JWT_SEGREDO=
CONVITE_SEGREDO=
# Chaves de cifragem em repouso (32 bytes base64), uma por finalidade.
ORACAO_CHAVE=
TOTP_CHAVE=

# desligado | arquivo (só desenvolvimento) | resend
EMAIL_MODO=arquivo
NOTIFICADOR_ARQUIVO=./tmp/notificacoes.txt
EMAIL_REMETENTE=
RESEND_CHAVE=

# Obrigatório em homologação e produção (páginas públicas)
TURNSTILE_SEGREDO=

# Notificações push (F14): desligado | arquivo (só desenvolvimento) | real
PUSH_MODO=desligado
# Modo arquivo: onde gravar o que seria enviado
PUSH_ARQUIVO=./tmp/push.jsonl
# Caminhos de arquivos de chave fora do git (no Mac, com permissão 600).
# Android (FCM HTTP v1, D21): JSON da conta de serviço do Firebase.
FCM_CONTA_SERVICO_ARQUIVO=
# iOS (APNs, D22): chave .p8, ID da chave, time e tópico (bundle do app deste ambiente:
# com.solerte.unijovem em produção, com.solerte.unijovem.hml em homologação).
APNS_CHAVE_ARQUIVO=
APNS_CHAVE_ID=
APNS_TIME_ID=
APNS_TOPICO=

# Página /suporte (sem valor, mostra [PREENCHER])
SUPORTE_EMAIL=
# assetlinks.json: impressões SHA-256 dos certificados Android, separadas por vírgula
ANDROID_SHA256_IMPRESSOES=

# Só para as tarefas diárias e as migrações (papel dono do banco). A API não usa.
DATABASE_URL_DONO=
