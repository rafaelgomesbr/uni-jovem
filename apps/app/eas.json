{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.17.0",
      "env": { "EXPO_NO_TELEMETRY": "1" }
    },
    "desenvolvimento": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "UJ_VARIANTE": "desenvolvimento",
        "EXPO_PUBLIC_API_URL": "https://unijovem-hml.solerte.com.br"
      }
    },
    "homologacao": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "UJ_VARIANTE": "homologacao",
        "EXPO_PUBLIC_API_URL": "https://unijovem-hml.solerte.com.br"
      }
    },
    "producao": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "UJ_VARIANTE": "producao", "EXPO_PUBLIC_API_URL": "https://unijovem.solerte.com.br" }
    }
  },
  "submit": {
    "producao": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
